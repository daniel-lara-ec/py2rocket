# Configuración de la API de Rocket
# Copia este archivo a .env y completa con tus valores

# Host de la API de Rocket (sin / al final)
ROCKET_API_HOST=https://your-rocket-host.com

# Cookie de autenticación de Rocket
ROCKET_AUTH_COOKIE=your_auth_cookie_here

# Nombre del proyecto por defecto (opcional)
# Si se configura, se usará como valor por defecto al crear pipelines
PROJECT_NAME=your_project_name_here

# UUID del proyecto por defecto (opcional)
# Si se configura, se usará automáticamente al crear pipelines
# sin necesidad de especificar --project-name
PROJECT_ID=your_project_uuid_here

# Establece la verificación SSL para las conexiones a Rocket (true/false)
ROCKET_VERIFY_SSL=true

# Suprime el warning InsecureRequestWarning cuando ROCKET_VERIFY_SSL=false (true/false)
# Default: true
ROCKET_SUPPRESS_INSECURE_REQUEST_WARNING=true

# Archivo opcional para log de errores HTTP (incluye status_code y response_text)
# Rotación automática: al llegar a 5MB se renombra a <archivo>.1
# Ejemplo: ROCKET_HTTP_ERROR_LOG_FILE=py2rocket_errors.log
ROCKET_HTTP_ERROR_LOG_FILE=

# Demo de migración de assets a Databricks
# Proyecto: acepta ID, nombre o normalizedName. Vacío solicita selección.
PY2ROCKET_MIGRATION_PROJECT=

# Grupo relativo al proyecto. Vacío migra el proyecto completo.
PY2ROCKET_MIGRATION_GROUP_PATH=

# Directorio local con las carpetas rocket/ y databricks/
PY2ROCKET_MIGRATION_OUTPUT=migracion_databricks

# Mapping JSON opcional de Unity Catalog
PY2ROCKET_UNITY_CATALOG_MAP=

# Sobrescribir workflows ya descargados (true/false)
PY2ROCKET_MIGRATION_FORCE=false
